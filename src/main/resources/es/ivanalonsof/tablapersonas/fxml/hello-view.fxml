<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="531.0" prefWidth="407.0" spacing="5.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.ivanalonsof.tablapersonas.controladores.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox>
         <children>
            <Label maxWidth="120.0" minWidth="120.0" prefWidth="120.0" text="Nombre:">
               <HBox.margin>
                  <Insets left="5.0" right="5.0" />
               </HBox.margin>
            </Label>
            <TextField fx:id="txtNombre">
               <HBox.margin>
                  <Insets right="5.0" />
               </HBox.margin>
            </TextField>
            <Button mnemonicParsing="false" onAction="#anadirPersona" text="Añadir" />
         </children>
      </HBox>
      <HBox>
         <children>
            <Label maxWidth="120.0" minWidth="120.0" prefWidth="120.0" text="Apellido: ">
               <HBox.margin>
                  <Insets left="5.0" right="5.0" />
               </HBox.margin>
            </Label>
            <TextField fx:id="txtApellido" />
         </children>
      </HBox>
      <HBox>
         <children>
            <Label maxWidth="120.0" minWidth="120.0" prefWidth="120.0" text="Fecha de nacimiento:">
               <HBox.margin>
                  <Insets left="5.0" right="5.0" />
               </HBox.margin>
            </Label>
            <DatePicker fx:id="dpFechaNacimiento" />
         </children>
      </HBox>
      <HBox>
         <children>
            <Button mnemonicParsing="false" onAction="#restaurarPersonas" text="Restaurar filas" />
            <Button mnemonicParsing="false" onAction="#borrarPersonas" text="Borrar filas seleccionadas" />
         </children>
      </HBox>
      <TableView fx:id="tablaPersonas" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" editable="false" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colNombre" editable="false" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colApellido" editable="false" prefWidth="85.0" text="Apellido" />
            <TableColumn fx:id="colFechaNac" editable="false" prefWidth="133.0" text="Fecha de nacimiento" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
